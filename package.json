{
  "name": "deveco-dag",
  "version": "0.5.1",
  "description": "DAG planning and worktree agents with local Gitea for OpenCode 1.19.5 on macOS and Windows x64",
  "license": "MIT",
  "type": "module",
  "main": "./src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./server": "./src/plugin.js",
    "./tui": "./dist/tui.js"
  },
  "bin": {
    "deveco-dag": "./bin/cli.js"
  },
  "os": [
    "win32",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "src/",
    "prompts/",
    "assets/",
    "dist/",
    "vendor/gitea/",
    "bin/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build -- --verify-bundled-gitea",
    "test": "node --test test/*.test.js",
    "test:integration": "node test/integration.mjs",
    "test:run": "node test/run-integration.mjs",
    "test:ux": "node test/ux-run.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "babel-preset-solid": "^1.9.19"
  }
}
